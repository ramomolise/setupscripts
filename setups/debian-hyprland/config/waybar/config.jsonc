{
  "layer": "top",
  "position": "top",
  "height": 38,
  "modules-left": ["custom/brand", "hyprland/workspaces", "hyprland/window"],
  "modules-center": ["clock"],
  "modules-right": ["custom/gpu", "network", "pulseaudio", "tray"],
  "custom/brand": {"format": "RM / HYPR", "tooltip": false},
  "hyprland/workspaces": {"on-click": "activate", "persistent-workspaces": {"*": 5}},
  "hyprland/window": {"format": "{title}", "max-length": 48},
  "clock": {"format": "{:%a %d %b  %H:%M}"},
  "custom/gpu": {
    "exec": "sh -c 'state=$(cat /run/gpu-passthrough-switch.state 2>/dev/null || true); printf \"GPU: %s\\n\" \"${state:-not installed}\"'",
    "interval": 5
  },
  "network": {"format-wifi": "Wi-Fi {signalStrength}%", "format-ethernet": "Ethernet", "format-disconnected": "Offline"},
  "pulseaudio": {"format": "VOL {volume}%", "format-muted": "MUTED", "on-click": "pavucontrol"},
  "tray": {"spacing": 8}
}
