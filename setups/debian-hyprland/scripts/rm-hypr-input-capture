#!/usr/bin/env bash
set -u

state_root="${XDG_STATE_HOME:-$HOME/.local/state}/rm-architect"
armed="$state_root/hypr-input-capture.armed"
[[ -f $armed ]] || exit 0

stamp=$(date +%Y%m%d-%H%M%S)
capture="$state_root/hypr-input-capture-$stamp"
mkdir -p -m 0700 "$capture" || exit 0
mv -- "$armed" "$capture/armed" 2>/dev/null || exit 0

report="$capture/report.txt"
exec >"$report" 2>&1

run() {
    printf '\n$'
    printf ' %q' "$@"
    printf '\n'
    "$@" 2>&1 || printf '[exit=%s]\n' "$?"
}

snapshot() {
    local label=$1 event properties device
    printf '\n===== SNAPSHOT %s %s =====\n' "$label" "$(date --iso-8601=ns)"
    run loginctl show-session "${XDG_SESSION_ID:-self}" -p Id -p Name -p User -p Seat -p VTNr -p Active -p State -p Type -p Class -p Desktop -p Service -p Scope -p Leader -p Timestamp -p ActiveEnterTimestamp
    run loginctl seat-status seat0
    run hyprctl -j devices
    run systemctl --user show graphical-session.target -p ActiveState -p SubState -p ActiveEnterTimestamp -p Wants -p After
    run systemctl --user show lan-mouse.service -p LoadState -p ActiveState -p SubState -p MainPID -p ExecMainStartTimestamp -p FragmentPath

    for event in /dev/input/event*; do
        properties=$(udevadm info -q property "$event" 2>/dev/null) || continue
        if grep -Eqi 'ID_VENDOR_ID=(2e3c|0458)|ID_MODEL=(Gaming_Keyboard|Optical_Mouse)' <<<"$properties"; then
            printf '\nINPUT_NODE=%s\n%s\n' "$event" "$properties"
        fi
    done

    for device in /sys/bus/usb/devices/*; do
        [[ -r $device/idVendor && -r $device/idProduct ]] || continue
        case "$(<"$device/idVendor"):$(<"$device/idProduct")" in
            2e3c:c365|0458:003a)
                printf '\nUSB_DEVICE=%s\n' "$device"
                for property in idVendor idProduct product manufacturer busnum devnum devpath power/control power/autosuspend power/autosuspend_delay_ms power/runtime_status; do
                    [[ -r $device/$property ]] && printf '%s=%s\n' "$property" "$(<"$device/$property")"
                done
                ;;
        esac
    done
}

printf 'capture_started=%s\n' "$(date --iso-8601=ns)"
printf 'boot_id=%s\n' "$(</proc/sys/kernel/random/boot_id)"
printf 'uptime=%s\n' "$(</proc/uptime)"
printf 'XDG_SESSION_ID=%s\nXDG_SESSION_TYPE=%s\nXDG_CURRENT_DESKTOP=%s\nDESKTOP_SESSION=%s\nHYPRLAND_INSTANCE_SIGNATURE=%s\nWAYLAND_DISPLAY=%s\n' \
    "${XDG_SESSION_ID:-}" "${XDG_SESSION_TYPE:-}" "${XDG_CURRENT_DESKTOP:-}" \
    "${DESKTOP_SESSION:-}" "${HYPRLAND_INSTANCE_SIGNATURE:-}" "${WAYLAND_DISPLAY:-}"
run hyprctl version
run hyprctl configerrors
run hyprctl -j instances
run loginctl session-status "${XDG_SESSION_ID:-self}"

snapshot t0
sleep 1
snapshot t1
sleep 2
snapshot t3
sleep 7
snapshot t10

run journalctl -b -k -o short-precise --no-pager
run journalctl -b -o short-precise --no-pager
run journalctl --user -b -o short-precise --no-pager
run journalctl --user -b -u lan-mouse.service -o short-precise --no-pager

hypr_log="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr/${HYPRLAND_INSTANCE_SIGNATURE:-}/hyprland.log"
if [[ -r $hypr_log ]]; then
    run cp -- "$hypr_log" "$capture/hyprland.log"
fi

printf '\ncapture_finished=%s\n' "$(date --iso-8601=ns)"
