[Unit]
Description=Return NVIDIA GPU to VFIO during host shutdown
After=local-fs.target pve-cluster.service
Before=display-manager.service pve-guests.service

[Service]
Type=oneshot
ExecStart=/usr/bin/true
RemainAfterExit=yes
ExecStop=/usr/local/sbin/gpu-passthrough-switch prepare-shutdown
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target

